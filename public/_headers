# Cloudflare Pages / Workers 静态资源会读取这个文件，把响应头加到线上。
# 语法：先写路径规则，缩进两格的键值对属于该规则；多条规则会同时生效。

# ---------------------------------------------------------------- 全局安全头
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=15552000
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  # Cloudflare Web Analytics 的 beacon 由 Cloudflare 自动注入 HTML，
  # 所以 script-src / connect-src 必须放行 cloudflareinsights.com，否则统计一条都收不到。
  Content-Security-Policy: default-src 'self'; script-src 'self' blob: https://static.cloudflareinsights.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cloudflareinsights.com; font-src 'self'; media-src 'self' blob: https://music.163.com https://*.music.126.net; connect-src 'self' blob: data: https://music.163.com https://*.music.126.net https://cloudflareinsights.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'; upgrade-insecure-requests
#
# Cross-Origin-Resource-Policy: same-origin 会阻止其它网站把你的图片/贴图当图床外链
# （也就是常见的"盗图/盗链"）。如果以后需要让别的站引用本站图片，删掉这一行即可。

# ---------------------------------------------------------------- 缓存策略
# 带内容哈希的构建产物：一年、不可变
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# 贴图与音频资源：一周
/planets/*
  Cache-Control: public, max-age=604800

/moons/*
  Cache-Control: public, max-age=604800

/images/*
  Cache-Control: public, max-age=604800

/textures/*
  Cache-Control: public, max-age=604800

# 数据清单：一天（重新构建后能较快刷新）
/data/*
  Cache-Control: public, max-age=86400

/audio/*
  Cache-Control: public, max-age=86400

# HTML 入口始终回源校验，保证发新版立刻生效
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate
