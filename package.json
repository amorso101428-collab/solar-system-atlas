{
  "name": "ocean-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "pack:assets": "node scripts/pack-source-assets.mjs",
    "prepare:assets": "node scripts/restore-source-assets.mjs",
    "verify:assets": "node scripts/restore-source-assets.mjs --verify",
    "postinstall": "node scripts/restore-source-assets.mjs",
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "build:pages": "node scripts/build.mjs && node scripts/build-pages.mjs",
    "deploy:pages": "npm run build:pages && npx --yes wrangler@4.138.0 pages deploy dist-pages --project-name=solar-system-atlas --branch=main",
    "build:vite": "vite build",
    "preview": "node scripts/serve.mjs",
    "preview:pages": "node --dns-result-order=ipv4first scripts/serve-pages.mjs",
    "test": "node scripts/check.mjs",
    "test:pages": "node tests/pages-service.mjs && node tests/pages-packed-tiles.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:solar": "tsc --noEmit -p integrations/solar-system-atlas/tsconfig.json",
    "install:solar": "npm install --prefix integrations/solar-system-atlas"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@mapbox/vector-tile": "^3.0.0",
    "@react-three/drei": "9.114.3",
    "@react-three/fiber": "8.17.10",
    "pbf": "^5.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.186.1",
    "topojson-client": "3.1.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.28.2",
    "opencc-js": "^1.4.2",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
